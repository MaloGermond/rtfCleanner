\pard\pardeftab720\li1275\ri1291\sa241\qj\partightenfactor0\n\f1\b0 \cf2 What\'92s Needed?\

\pard\tx1635\tx1995\pardeftab720\li1995\fi-1995\ri1293\partightenfactor0
\ls80\ilvl3
\f5 \cf2 \up0 \nosupersub \ulnone {\listtext	\'81\'9c	}
