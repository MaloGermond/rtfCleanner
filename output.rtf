\pard\tx2355\tx2715\pardeftab720\li2715\fi-2715\ri1294\partightenfactor0
\ls124\ilvl1
\f5 \cf2 \up0 \nosupersub \ulnone {\listtext	\'81\'9b	}
\f1 \up0 \nosupersub \ulnone Solar-based micro-distribution (e.g., Solar Sister ) is gaining traction in South Africa and Kenya.\par
\pard\tx2355\tx2715\tx3931\tx5138\tx6197\tx7392\tx8390\tx9174\pardeftab720\li2715\fi-2715\ri1297\sa3\partightenfactor0
